# Hetzner Object Storage (EDFX S3 Bucket)
HETZNER_S3_ENDPOINT=hel1.your-objectstorage.com
HETZNER_S3_BUCKET=edfx
HETZNER_S3_REGION=hel1
HETZNER_S3_ACCESS_KEY=your_hetzner_s3_access_key
HETZNER_S3_SECRET_KEY=your_hetzner_s3_secret_key
S3_SSL=true

# Optional: Global prefix inside the S3 bucket
S3_BUCKET_PATH=

# Smart Retention Defaults
BACKUP_SMART_RETENTION=true
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=26
BACKUP_KEEP_MONTHLY=6
